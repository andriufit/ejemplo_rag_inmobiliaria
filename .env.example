# Copia este fichero a .env y ajustalo a tu maquina.

# MySQL / MariaDB de XAMPP (si tu 3306 esta ocupado, arranca XAMPP en otro
# puerto y ponlo aqui)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=inmobiliaria

QDRANT_URL=http://localhost:6333
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=paraphrase-multilingual
EMBEDDING_DIM=768
LLM_MODEL=gemma3

# Puerto de la app (el 5000 suele estar reservado en Windows)
PORT=8000
